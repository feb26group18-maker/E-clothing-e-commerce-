{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "authRoute": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "usersRoute": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/users/{**catch-all}"
        }
      },
      "customersRoute": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/customers/{**catch-all}"
        }
      },
      "sellersRoute": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/sellers/{**catch-all}"
        }
      },
      "productsRoute": {
        "ClusterId": "productCluster",
        "Match": {
          "Path": "/products/{**catch-all}"
        }
      },
      "categoriesRoute": {
        "ClusterId": "productCluster",
        "Match": {
          "Path": "/categories/{**catch-all}"
        }
      },
      "subcategoriesRoute": {
        "ClusterId": "productCluster",
        "Match": {
          "Path": "/subcategories/{**catch-all}"
        }
      },
      "ordersRoute": {
        "ClusterId": "orderCluster",
        "Match": {
          "Path": "/orders/{**catch-all}"
        }
      },
      "inventoryRoute": {
        "ClusterId": "orderCluster",
        "Match": {
          "Path": "/inventory/{**catch-all}"
        }
      },
      "cartRoute": {
        "ClusterId": "orderCluster",
        "Match": {
          "Path": "/cart/{**catch-all}"
        }
      },
      "wishlistRoute": {
        "ClusterId": "orderCluster",
        "Match": {
          "Path": "/wishlist/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "authCluster": {
        "Destinations": {
          "authService": {
            "Address": "http://localhost:9001"
          }
        }
      },
      "productCluster": {
        "Destinations": {
          "productService": {
            "Address": "http://localhost:9002"
          }
        }
      },
      "orderCluster": {
        "Destinations": {
          "orderService": {
            "Address": "http://localhost:9003"
          }
        }
      }
    }
  }
}
